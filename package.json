{
  "name": "character-forge",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "author": "S3bt3r (https://github.com/S3bt3r)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S3bt3r/character-forge.git"
  },
  "engines": {
    "node": ">=24.11"
  },
  "description": "Browser questionnaire that recommends a class, specialization, race, professions and Legacy perks for World of Warcraft: Forever.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" && knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mutation": "stryker run",
    "test:mutation:ui": "stryker run stryker.ui.config.json"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/marcellus-sc": "5.3.0",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/preact": "3.2.6",
    "eslint": "10.13.0",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
